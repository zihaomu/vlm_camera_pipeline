+bool ggml_backend_cuda_tensor_set_from_device_ptr(
+        ggml_tensor * tensor,
+        const void * device_ptr,
+        size_t size,
+        int source_device,
+        void * ready_event) {
+    if (tensor == nullptr || tensor->buffer == nullptr || device_ptr == nullptr) {
+        GGML_LOG_ERROR("%s: null tensor, buffer, or source device pointer\n", __func__);
+        return false;
+    }
+    if (!ggml_backend_buffer_is_cuda(tensor->buffer)) {
+        GGML_LOG_ERROR(
+            "%s: destination tensor %s is in non-%s buffer %s\n",
+            __func__,
+            tensor->name,
+            GGML_CUDA_NAME,
+            ggml_backend_buffer_name(tensor->buffer));
+        return false;
+    }
+    if (size != ggml_nbytes(tensor)) {
+        GGML_LOG_ERROR(
+            "%s: byte size mismatch source=%zu destination=%zu\n",
+            __func__,
+            size,
+            ggml_nbytes(tensor));
+        return false;
+    }
+    auto * ctx = static_cast<ggml_backend_cuda_buffer_context *>(tensor->buffer->context);
+    if (ggml_cuda_get_physical_device(ctx->device) != source_device) {
+        GGML_LOG_ERROR(
+            "%s: physical device mismatch source=%d destination=%d\n",
+            __func__,
+            source_device,
+            ggml_cuda_get_physical_device(ctx->device));
+        return false;
+    }
+    ggml_cuda_set_device(ctx->device);
+    if (ready_event != nullptr) {
+        CUDA_CHECK(cudaStreamWaitEvent(cudaStreamPerThread, static_cast<cudaEvent_t>(ready_event), 0));
+    }
+    CUDA_CHECK(cudaMemcpyAsync(
+        tensor->data,
+        device_ptr,
+        size,
+        cudaMemcpyDeviceToDevice,
+        cudaStreamPerThread));
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+    return true;
+}
+
+bool ggml_backend_cuda_tensor_get_device_ptr(
+        const ggml_tensor * tensor,
+        const void ** device_ptr,
+        size_t * size,
+        int * physical_device) {
+    if (tensor == nullptr || tensor->buffer == nullptr || tensor->data == nullptr ||
+        device_ptr == nullptr || size == nullptr || physical_device == nullptr) {
+        GGML_LOG_ERROR("%s: null tensor, tensor storage, or output argument\n", __func__);
+        return false;
+    }
+    if (!ggml_backend_buffer_is_cuda(tensor->buffer)) {
+        GGML_LOG_ERROR(
+            "%s: tensor %s is in non-%s buffer %s\n",
+            __func__,
+            tensor->name,
+            GGML_CUDA_NAME,
+            ggml_backend_buffer_name(tensor->buffer));
+        return false;
+    }
+    if (!ggml_is_contiguous(tensor)) {
+        GGML_LOG_ERROR("%s: tensor %s is not contiguous\n", __func__, tensor->name);
+        return false;
+    }
+    auto * ctx = static_cast<ggml_backend_cuda_buffer_context *>(tensor->buffer->context);
+    *device_ptr = tensor->data;
+    *size = ggml_nbytes(tensor);
+    *physical_device = ggml_cuda_get_physical_device(ctx->device);
+    return true;
+}
+
 static void * ggml_backend_cuda_buffer_get_base(ggml_backend_buffer_t buffer) {
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *)buffer->context;
     return ctx->dev_ptr;
